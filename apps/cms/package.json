{
  "name": "portfolio-cms",
  "version": "1.0.0",
  "description": "Strapi CMS for portfolio",
  "private": true,
  "scripts": {
    "dev": "npm run develop",
    "develop": "concurrently \"node scripts/sync-schemas.js --watch\" \"strapi develop\"",
    "start": "strapi start",
    "build": "strapi build && node scripts/sync-schemas.js",
    "strapi": "strapi",
    "clean": "rm -rf node_modules/.cache .next dist"
  },
  "dependencies": {
    "@strapi/plugin-i18n": "4.26.2",
    "@strapi/plugin-users-permissions": "4.26.2",
    "@strapi/provider-upload-cloudinary": "^5.50.1",
    "@strapi/strapi": "4.26.2",
    "date-fns": "^2.30.0",
    "fs-extra": "^10.0.0",
    "jose": "^6.2.3",
    "lodash": "^4.18.1",
    "pg": "^8.11.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^5.3.4",
    "sharp": "^0.33.5",
    "styled-components": "^5.3.11",
    "url-join": "^4.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@strapi/typescript-utils": "4.26.2",
    "@types/node": "^20.10.6",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "strapi": {
    "uuid": "your-uuid-here"
  }
}
